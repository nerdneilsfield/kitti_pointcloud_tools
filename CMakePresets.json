{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "kpt-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "KPT_BUILD_TESTS": true
      }
    },
    {
      "name": "linux-system-base",
      "hidden": true,
      "inherits": "kpt-base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "toolchainFile": "${sourceDir}/cmake/toolchains/linux-system.cmake",
      "cacheVariables": {
        "KPT_BUILD_GUI": true,
        "KPT_GUI_BACKEND": "opengl"
      }
    },
    {
      "name": "linux-vcpkg-base",
      "hidden": true,
      "inherits": "kpt-base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "toolchainFile": "${sourceDir}/cmake/toolchains/linux-vcpkg.cmake",
      "cacheVariables": {
        "KPT_BUILD_GUI": true,
        "KPT_GUI_BACKEND": "opengl",
        "VCPKG_MANIFEST_FEATURES": "platform-fonts"
      }
    },
    {
      "name": "windows-x64-vcpkg-base",
      "hidden": true,
      "inherits": "kpt-base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "toolchainFile": "${sourceDir}/cmake/toolchains/windows-x64-vcpkg.cmake",
      "cacheVariables": {
        "KPT_BUILD_GUI": true,
        "KPT_GUI_BACKEND": "opengl"
      }
    },
    {
      "name": "macos-arm64-vcpkg-base",
      "hidden": true,
      "inherits": "kpt-base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "toolchainFile": "${sourceDir}/cmake/toolchains/macos-arm64-vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "13.0",
        "KPT_BUILD_GUI": true,
        "KPT_GUI_BACKEND": "metal",
        "VCPKG_MANIFEST_FEATURES": "platform-fonts"
      }
    },
    {
      "name": "macos-x64-vcpkg-base",
      "hidden": true,
      "inherits": "kpt-base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "toolchainFile": "${sourceDir}/cmake/toolchains/macos-x64-vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "x86_64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "13.0",
        "KPT_BUILD_GUI": true,
        "KPT_GUI_BACKEND": "metal",
        "VCPKG_MANIFEST_FEATURES": "platform-fonts"
      }
    },
    {
      "name": "linux-system-debug",
      "inherits": "linux-system-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "linux-system-release",
      "inherits": "linux-system-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "linux-vcpkg-debug",
      "inherits": "linux-vcpkg-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "linux-vcpkg-release",
      "inherits": "linux-vcpkg-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "windows-x64-vcpkg-debug",
      "inherits": "windows-x64-vcpkg-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "windows-x64-vcpkg-release",
      "inherits": "windows-x64-vcpkg-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "macos-arm64-vcpkg-debug",
      "inherits": "macos-arm64-vcpkg-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "macos-arm64-vcpkg-release",
      "inherits": "macos-arm64-vcpkg-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "macos-x64-vcpkg-debug",
      "inherits": "macos-x64-vcpkg-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "macos-x64-vcpkg-release",
      "inherits": "macos-x64-vcpkg-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "web-release",
      "inherits": "kpt-base",
      "toolchainFile": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "KPT_BUILD_WEB": true,
        "KPT_GUI_BACKEND": "webgl",
        "KPT_BUILD_TESTS": false,
        "KPT_BUILD_RENDER": false,
        "ENABLE_TOOLS": false
      }
    }
  ],
  "buildPresets": [
    {
      "name": "linux-build-base",
      "hidden": true,
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "windows-build-base",
      "hidden": true,
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "macos-build-base",
      "hidden": true,
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "linux-system-debug",
      "inherits": "linux-build-base",
      "configurePreset": "linux-system-debug"
    },
    {
      "name": "linux-system-release",
      "inherits": "linux-build-base",
      "configurePreset": "linux-system-release"
    },
    {
      "name": "linux-vcpkg-debug",
      "inherits": "linux-build-base",
      "configurePreset": "linux-vcpkg-debug"
    },
    {
      "name": "linux-vcpkg-release",
      "inherits": "linux-build-base",
      "configurePreset": "linux-vcpkg-release"
    },
    {
      "name": "windows-x64-vcpkg-debug",
      "inherits": "windows-build-base",
      "configurePreset": "windows-x64-vcpkg-debug"
    },
    {
      "name": "windows-x64-vcpkg-release",
      "inherits": "windows-build-base",
      "configurePreset": "windows-x64-vcpkg-release"
    },
    {
      "name": "macos-arm64-vcpkg-debug",
      "inherits": "macos-build-base",
      "configurePreset": "macos-arm64-vcpkg-debug"
    },
    {
      "name": "macos-arm64-vcpkg-release",
      "inherits": "macos-build-base",
      "configurePreset": "macos-arm64-vcpkg-release"
    },
    {
      "name": "macos-x64-vcpkg-debug",
      "inherits": "macos-build-base",
      "configurePreset": "macos-x64-vcpkg-debug"
    },
    {
      "name": "macos-x64-vcpkg-release",
      "inherits": "macos-build-base",
      "configurePreset": "macos-x64-vcpkg-release"
    },
    {
      "name": "web-release",
      "configurePreset": "web-release",
      "targets": ["kpt_web"]
    }
  ],
  "testPresets": [
    {
      "name": "linux-test-base",
      "hidden": true,
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "windows-test-base",
      "hidden": true,
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "macos-test-base",
      "hidden": true,
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "linux-system-debug",
      "inherits": "linux-test-base",
      "configurePreset": "linux-system-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-system-release",
      "inherits": "linux-test-base",
      "configurePreset": "linux-system-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-vcpkg-debug",
      "inherits": "linux-test-base",
      "configurePreset": "linux-vcpkg-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-vcpkg-release",
      "inherits": "linux-test-base",
      "configurePreset": "linux-vcpkg-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-x64-vcpkg-debug",
      "inherits": "windows-test-base",
      "configurePreset": "windows-x64-vcpkg-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-x64-vcpkg-release",
      "inherits": "windows-test-base",
      "configurePreset": "windows-x64-vcpkg-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "macos-arm64-vcpkg-debug",
      "inherits": "macos-test-base",
      "configurePreset": "macos-arm64-vcpkg-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "macos-arm64-vcpkg-release",
      "inherits": "macos-test-base",
      "configurePreset": "macos-arm64-vcpkg-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "macos-x64-vcpkg-debug",
      "inherits": "macos-test-base",
      "configurePreset": "macos-x64-vcpkg-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "macos-x64-vcpkg-release",
      "inherits": "macos-test-base",
      "configurePreset": "macos-x64-vcpkg-release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
