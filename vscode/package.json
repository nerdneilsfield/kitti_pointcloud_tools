{
  "name": "pointcloud-tools",
  "displayName": "Point Cloud Tools",
  "description": "View, play, and convert point clouds with KPT's native WebAssembly codecs and Three.js.",
  "version": "0.1.5",
  "publisher": "dengqi",
  "author": {
    "name": "DengQi",
    "url": "https://github.com/nerdneilsfield"
  },
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "https://github.com/nerdneilsfield/kitti_pointcloud_tools.git"
  },
  "homepage": "https://github.com/nerdneilsfield/kitti_pointcloud_tools#readme",
  "bugs": {
    "url": "https://github.com/nerdneilsfield/kitti_pointcloud_tools/issues"
  },
  "keywords": [
    "kitti",
    "point-cloud",
    "lidar",
    "pcd",
    "ply",
    "three.js",
    "webassembly",
    "visualization"
  ],
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Visualization"
  ],
  "pricing": "Free",
  "activationEvents": [
    "onCustomEditor:kpt.pointCloudViewer",
    "onCustomEditor:kpt.binaryPointCloudViewer",
    "onCommand:kpt.openSequence",
    "onCommand:kpt.openPointCloud",
    "onCommand:kpt.convertPointCloud"
  ],
  "main": "./dist/extension.js",
  "browser": "./dist/browser.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "kpt.openSequence",
        "title": "KPT: Open Point Cloud Sequence"
      },
      {
        "command": "kpt.openPointCloud",
        "title": "KPT: Open Point Cloud"
      },
      {
        "command": "kpt.convertPointCloud",
        "title": "KPT: Convert Point Cloud"
      }
    ],
    "configuration": {
      "title": "Point Cloud Tools",
      "properties": {
        "kpt.maxFileSizeMiB": {
          "type": "number",
          "default": 256,
          "minimum": 1,
          "maximum": 512,
          "description": "Maximum point-cloud file size read by the extension host."
        }
      }
    },
    "customEditors": [
      {
        "viewType": "kpt.pointCloudViewer",
        "displayName": "Point Cloud Viewer",
        "selector": [
          {
            "filenamePattern": "*.pcd"
          },
          {
            "filenamePattern": "*.ply"
          },
          {
            "filenamePattern": "*.xyz"
          },
          {
            "filenamePattern": "*.xyzi"
          },
          {
            "filenamePattern": "*.xyzrgb"
          },
          {
            "filenamePattern": "*.xyzrgbi"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "kpt.binaryPointCloudViewer",
        "displayName": "KITTI BIN Point Cloud Viewer",
        "selector": [
          {
            "filenamePattern": "*.bin"
          }
        ],
        "priority": "option"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "kpt.openPointCloud",
          "when": "resourceExtname =~ /\\.(bin|pcd|ply|xyz|xyzi|xyzrgb|xyzrgbi)$/i",
          "group": "navigation@20"
        },
        {
          "command": "kpt.convertPointCloud",
          "when": "resourceExtname =~ /\\.(bin|pcd|ply|xyz|xyzi|xyzrgb|xyzrgbi)$/i",
          "group": "navigation@21"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "node scripts/prepublish.mjs",
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit && npm run build",
    "package:vsix": "vsce package",
    "test:browser": "node tests/browser-smoke.mjs",
    "test:vscode": "node tests/run-vscode-test.mjs",
    "benchmark": "node tests/performance-benchmark.mjs"
  },
  "dependencies": {
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.0.0",
    "@types/three": "^0.183.1",
    "@types/vscode": "^1.96.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "3.9.2",
    "esbuild": "^0.28.1",
    "typescript": "^7.0.2"
  }
}
